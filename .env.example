# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Social-proof trust banner (top of site). Change as viewership grows.
NEXT_PUBLIC_VIEWS_LABEL=Over 1 million monthly views

# Bunny Stream (video hosting)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_CDN_HOSTNAME=

# Admin access (comma-separated emails)
ADMIN_EMAILS=dagmawiabebe19@gmail.com

# Creator submissions (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ReelWalia Submissions <onboarding@resend.dev>
SUBMISSION_NOTIFY_EMAIL=info@waliastudios.media

# OpenAI (poster generation)
OPENAI_API_KEY=

# AI Character Chat (Anthropic)
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5
# Platform-wide daily model-call ceiling (UTC). 0 or unset = disabled.
# When exceeded, chat returns a graceful pause message and skips Anthropic.
CHAT_GLOBAL_DAILY_CAP=5000

# Stripe — checkout + renewal Price IDs (must match lib/stripe/plans.ts amountCents)
# 1-week $1.00  → STRIPE_PRICE_1WEEK_INTRO
# 2-week $1.75  → STRIPE_PRICE_2WEEK_INTRO
# 1-month $4.00 → STRIPE_PRICE_1MONTH_INTRO
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_1WEEK_INTRO=
STRIPE_PRICE_1WEEK_STANDARD=
STRIPE_PRICE_2WEEK_INTRO=
STRIPE_PRICE_2WEEK_STANDARD=
STRIPE_PRICE_1MONTH_INTRO=
STRIPE_PRICE_1MONTH_STANDARD=
